# --- NetBox connection (100% REST API, read and write) ---
NETBOX_URL=http://localhost:8000
# Fallback token, used only when a request carries no Authorization header
# (local dev, tests, CI). Real MCP usage passes through each user's own
# NetBox token instead — see src/netbox_mcp/auth.py.
NETBOX_API_TOKEN=changeme-service-account-token

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_AUTH_TOKEN=changeme-secret-shared-with-mcp-remote
