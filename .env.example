# --- NetBox connection (100% REST API, read and write) ---
NETBOX_URL=http://localhost:8000
# No server-side token: every MCP request must send the caller's own NetBox
# token as `Authorization: Bearer <token>` (see src/netbox_mcp/auth.py).

# --- Integration tests only (pytest -m integration) ---
# A personal NetBox API token on the test instance, with netbox_branching
# view/add permissions. Never read by the server.
# NETBOX_TEST_TOKEN=changeme-personal-test-token

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Size cap, in bytes, of one tool result once serialized (lists over it are
# truncated). Keep it under ~500000: the result travels twice on the wire
# and MCP clients reject messages over ~1 MB.
# MCP_MAX_RESPONSE_BYTES=400000
